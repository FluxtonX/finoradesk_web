NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-only settings; never prefix secrets NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
PILOT_STARTER_CENTS=1900
PILOT_GROWTH_CENTS=4900
PILOT_BUSINESS_CENTS=9900

# Live keys are rejected unless deliberately enabled. Start with Stripe test keys.
BILLING_LIVE_ENABLED=false
# Confirm with the business/accountant before checkout (inclusive or exclusive):
BILLING_TAX_MODE=
STRIPE_AUTOMATIC_TAX=false

# Invoice delivery: disabled until an actual verified sender is configured.
EMAIL_MODE=disabled
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Finoredesk
EMAIL_REPLY_TO=
# Comma-separated inboxes you control; required in test mode.
EMAIL_TEST_RECIPIENTS=
CRON_SECRET=
EMAIL_WEBHOOK_SECRET=
